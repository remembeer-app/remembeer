{
  "name": "remembeer",
  "private": true,
  "scripts": {
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:generate": "npm run convex:codegen && npm run dartvex:codegen && dart format lib/convex_api",
    "convex:typecheck": "tsc -p convex/tsconfig.json",
    "dartvex:codegen": "dart run dartvex_codegen generate --project . --output lib/convex_api --flutter-widgets",
    "test": "node --test test/firestore-rules.test.js",
    "test:convex:access": "tsc -p test/access/tsconfig.json && node --test test/access/convex_access_test.mjs",
    "test:convex:logical-day": "node --harmony-temporal --test test/date/convex_logical_day_test.mjs",
    "test:convex:sessions": "node --harmony-temporal --test test/session/convex_sessions_test.mjs test/drink_log/convex_day_query_test.mjs",
    "test:convex:quests": "node --test test/party/convex_quest_schema_test.mjs test/party/convex_quest_gameplay_test.mjs",
    "test:convex:challenges": "node --test test/party/convex_challenges_test.mjs",
    "test:convex:beerpong": "node --test test/party/convex_beerpong_tournament_test.mjs",
    "test:convex:party": "node --test test/party/convex_party_standings_test.mjs test/party/convex_party_activity_test.mjs",
    "test:convex:leaderboards": "node --harmony-temporal --test test/leaderboard/convex_leaderboard_test.mjs",
    "test:convex:stats": "node --harmony-temporal --test test/user/convex_stats_test.mjs",
    "test:convex:friends": "node --test test/friendship/convex_friendship_test.mjs",
    "test:seed:drinks": "node --test test/drink/seed_data/convex_seed_test.mjs",
    "seed": "node scripts/seed_drinks.mjs",
    "seed:drinks": "convex run drink:seedGlobal",
    "lint": "oxlint --max-warnings=0 convex scripts test",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run convex:typecheck"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.3",
    "better-auth": "1.6.33",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "fluent-convex": "^0.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24",
    "firebase": "^12.2.1",
    "firebase-admin": "^14.5.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
