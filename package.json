{
  "name": "remembeer",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:generate": "npm run convex:codegen && npm run dartvex:codegen && dart format lib/convex_api",
    "convex:typecheck": "tsc -p convex/tsconfig.json",
    "dartvex:codegen": "dart run dartvex_codegen generate --project . --output lib/convex_api",
    "test": "node --test test/firestore-rules.test.js",
    "seed": "node scripts/seed_drink_types.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.3",
    "better-auth": "1.6.33",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "fluent-convex": "^0.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24",
    "firebase": "^12.2.1",
    "firebase-admin": "^14.4.0",
    "typescript": "5.9.2"
  }
}
