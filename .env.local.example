CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=<generated-admin-key>

CONVEX_URL=http://127.0.0.1:3210

CONVEX_SITE_URL=http://127.0.0.1:3211

# Better Auth Google provider: same web client ID as .env.client.
# Set these on the Convex deployment with `npx convex env set`.
GOOGLE_AUTH_SERVER_CLIENT_ID=your-server-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret
