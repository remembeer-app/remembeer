rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       DEFAULT: deny everything
       ========================= */
    match /{document=**} {
      allow read, write: if false;
    }

    /* =========================
       AUTH HELPERS
       ========================= */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /* =========================
       OWNERSHIP HELPERS
       ========================= */
    function isOwner(resourceData) {
      return isSignedIn() && resourceData.userId == uid();
    }

    function isOwnerCreate() {
      return isSignedIn() && request.resource.data.userId == uid();
    }

    /* =========================
       UPDATE SAFETY HELPERS
       ========================= */
    function ownershipUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function onlyUpdatingFields(allowedFields) {
      return request.resource.data.diff(resource.data)
        .changedKeys()
        .hasOnly(allowedFields);
    }

    /* =========================
       MEMBERSHIP HELPERS
       ========================= */
    function isMember() {
      return uid() in resource.data.memberIds;
    }

    function notBanned() {
      return !('bannedMemberIds' in resource.data)
        || !(uid() in resource.data.bannedMemberIds);
    }

    /* =========================
       SELF-ARRAY HELPERS
       ========================= */
    function arrayBefore(field) {
      return resource.data[field];
    }

    function arrayAfter(field) {
    return request.resource.data[field];
    }

    function selfAddedTo(field) {
      return !(uid() in arrayBefore(field))
        && (uid() in arrayAfter(field))
        && arrayAfter(field).size() == arrayBefore(field).size() + 1;
    }

    function selfRemovedFrom(field) {
      return (uid() in arrayBefore(field))
        && !(uid() in arrayAfter(field))
        && arrayAfter(field).size() == arrayBefore(field).size() - 1;
    }

    function onlySelfArrayChange(field) {
      return selfAddedTo(field) || selfRemovedFrom(field);
    }

    function isUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).changedKeys());
    }

    /* =========================
       PARTY HELPERS
       ========================= */
    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function partyPath(sessionId) {
      return /databases/$(database)/documents/parties/$(sessionId);
    }

    function isSessionMember(sessionId) {
      return isSignedIn()
        && exists(sessionPath(sessionId))
        && uid() in get(sessionPath(sessionId)).data.memberIds;
    }

    function isSessionAdmin(sessionId) {
      return isSessionMember(sessionId)
        && (
          get(sessionPath(sessionId)).data.userId == uid()
          || uid() in get(sessionPath(sessionId)).data.adminIds
        );
    }

    function isActiveParty(sessionId) {
      return isSessionMember(sessionId)
        && get(sessionPath(sessionId)).data.isParty == true
        && exists(partyPath(sessionId))
        && get(partyPath(sessionId)).data.status == "active";
    }

    /* =========================
       ADMIN HELPERS
       ========================= */
    function isAdmin() {
      return isSignedIn()
        && 'adminIds' in resource.data
        && uid() in resource.data.adminIds;
    }

    function adminIdsSelfRemovalOnly() {
      return isUnchanged('adminIds') || selfRemovedFrom('adminIds');
    }

    function validPartyFlagUpdate() {
      return isUnchanged("isParty")
        || (
          !('isParty' in resource.data)
          && request.resource.data.isParty == false
        );
    }

    function isPartySession(resourceData) {
      return 'isParty' in resourceData && resourceData.isParty == true;
    }

    function validSessionClientUpdate() {
      return validPartyFlagUpdate()
        && (
          !isPartySession(resource.data)
          || !request.resource.data.diff(resource.data).changedKeys().hasAny([
            "deletedAt",
            "drinks",
            "endedAt",
            "memberIds",
            "startedAt"
          ])
        );
    }

    function validAccentColorKey() {
      return request.resource.data.accentColorKey in [
        "amber",
        "rose",
        "violet",
        "sky",
        "emerald",
        "lime",
        "orange",
        "fuchsia"
      ];
    }

    function validOwnedUserUpdate() {
      return isUnchanged("accentColorKey")
        || (
          onlyUpdatingFields(["accentColorKey"])
          && validAccentColorKey()
        );
    }

    /* =========================
       COLLECTION RULES
       ========================= */
    match /drink_types/{id} {
      allow read: if isSignedIn()
        && (isOwner(resource.data) || resource.data.userId == "global");

      allow create: if isOwnerCreate();

      allow update: if isOwner(resource.data)
        && ownershipUnchanged();
    }

    match /friend_requests/{id} {
      allow read: if isSignedIn()
        && (resource.data.userId == uid() || resource.data.toUserId == uid());

      allow create: if isOwnerCreate();

      allow update: if isSignedIn()
        && (resource.data.userId == uid() || resource.data.toUserId == uid())
        && resource.data.userId == request.resource.data.userId
        && resource.data.toUserId == request.resource.data.toUserId;
    }

    match /leaderboards/{id} {
      allow read: if isSignedIn();

      allow create: if isOwnerCreate();

      allow update: if ownershipUnchanged()
        && (
          isOwner(resource.data)

          || (
            isSignedIn()
            && notBanned()
            && onlyUpdatingFields(["memberIds", "updatedAt"])
            && onlySelfArrayChange("memberIds")
          )
        );
    }

    match /sessions/{id} {
      allow read: if isSignedIn();

      allow create: if isOwnerCreate()
        && request.resource.data.isParty == false;

      allow update: if ownershipUnchanged()
        && validSessionClientUpdate()
        && (!isPartySession(resource.data) || isActiveParty(id))
        && (
          isOwner(resource.data)
          || (isAdmin()
              && onlyUpdatingFields(["name", "description", "startedAt", "endedAt", "drinks", "updatedAt", "pictureUrls"]))
          || (isSignedIn() && isMember() && notBanned()
              && onlyUpdatingFields(["memberIds", "adminIds", "drinks", "updatedAt"])
              && adminIdsSelfRemovalOnly())
        );
    }

    match /user_settings/{userId} {
      allow read, write: if isSignedIn() && userId == uid();
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if true;

      allow update: if isSignedIn()
        && userId == uid()
        && validOwnedUserUpdate();

      allow update: if isSignedIn()
        && userId != uid()
        && onlyUpdatingFields(["friends"])
        && onlySelfArrayChange("friends");
    }

    match /parties/{partyId} {
      allow read: if isSessionMember(partyId);
      allow write: if false;

      match /{document=**} {
        allow read: if isSessionMember(partyId);
        allow write: if false;
      }
    }
  }
}
